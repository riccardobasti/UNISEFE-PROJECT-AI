const SAFE_TAGS=new Set("main section article header footer nav div span h1 h2 h3 h4 h5 h6 p small strong em button input label textarea select option ul ol li a table thead tbody tr th td hr br".split(" "));
const SAFE_ATTRS=new Set("type placeholder min max step name role href target rel disabled checked selected aria-label aria-current aria-describedby title autocomplete inputmode pattern".split(" "));
function safeTagName(t){t=String(t||"div").toLowerCase();return SAFE_TAGS.has(t)?t:"div"}
function safeAttrValue(k,v){
  k=String(k||"").toLowerCase(); v=String(v??"");
  if(k.startsWith("aria-")) return v;
  if(!SAFE_ATTRS.has(k)) return null;
  if(k==="href"){const x=v.trim(); if(!/^(?:https?:|mailto:|tel:|#|\/)/i.test(x)) return "#"}
  if(k==="target" && !["_blank","_self"].includes(v)) return "_self";
  return v;
}
function safeStyleObject(o){
  const out={};
  for(const [k,v0] of Object.entries(o||{})){
    if(!/^[A-Za-z][A-Za-z0-9]*$/.test(k)) continue;
    const v=String(v0??"");
    if(/[{}<>]|url\s*\(|expression\s*\(|@import|javascript:/i.test(v)) continue;
    out[k]=v;
  }
  return out;
}

function appToHTML(value){
  const app=value?.rikiApp;
  if(!app)return "<!doctype html><html><body></body></html>"; normalizeApp(app); validateRikiApp(app,{derive:true});
  const A=app.VALORE||{};
  const st=o=>Object.entries(safeStyleObject(o)).map(([k,v])=>`${k.replace(/[A-Z]/g,m=>"-"+m.toLowerCase())}:${v}`).join(";");
  const nodes=(A.nodes||[]), map=Object.fromEntries(nodes.map(n=>[n.BYTE,n]));
  function renderNode(n){
    const v=n.VALORE||{},tag=safeTagName(v.tag||"div");
    const attrs=Object.entries(v.attrs||{}).map(([k,val])=>[k,safeAttrValue(k,val)]).filter(([,val])=>val!==null).map(([k,val])=>` ${String(k).toLowerCase()}="${esc(val)}"`).join("");
    const children=(v.children||[]).map(id=>map[id]).filter(Boolean).map(renderNode).join("");
    const raw=esc(v.text||"");
    const val=(tag==="input"&&v.value!=null)?` value="${esc(v.value)}"`:"";
    const voidTag=tag==="input"||tag==="hr"||tag==="br";
    return `<${tag} data-riki-byte="${esc(n.BYTE)}"${attrs}${val}${v.style?` style="${esc(st(v.style))}"`:""}>${voidTag?"":raw+children}${voidTag?"":`</${tag}>`}`;
  }
  const childIds=new Set(nodes.flatMap(n=>n.VALORE?.children||[]));
  const roots=nodes.filter(n=>!childIds.has(n.BYTE));
  const C=A.canvas||{},rels=JSON.stringify(app.CATENE||[]).replace(/</g,"\\u003c");
  return `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(A.title||app.BYTE)}</title><style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:system-ui,sans-serif}body{background:${C.background||"#fff"};color:${C.color||"#111"}}
#riki-root{max-width:${Number(C.maxWidth||1100)}px;margin:auto;padding:${Number(C.padding||24)}px;display:flex;flex-direction:column;gap:${Number(C.gap||16)}px}
button{cursor:pointer}input,textarea,select{font:inherit}@media(max-width:640px){#riki-root{padding:14px}}
</style></head><body><div id="riki-root">${roots.map(renderNode).join("")}</div><script>
const REL=${rels};const q=b=>document.querySelector('[data-riki-byte="'+CSS.escape(b)+'"]');
function read(b){const e=q(b);if(!e)return NaN;const raw=('value'in e)?e.value:e.textContent;const n=Number(String(raw).replace(/[^0-9eE+\\-.]/g,""));return Number.isFinite(n)?n:NaN}
function write(b,v,p){const e=q(b);if(!e)return;if(p==="value"&&'value'in e)e.value=v;else e.textContent=v}
function calc(expr,vars){expr=String(expr||"").trim();const names=Object.keys(vars),re=/[A-Za-z_][A-Za-z0-9_]*|(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+\\-]?\\d+)?|\\*\\*|[+\\-*/%()]|\\s+/gy;let i=0,m;while(i<expr.length){re.lastIndex=i;m=re.exec(expr);if(!m||m.index!==i)throw 0;const t=m[0];if(/^[A-Za-z_]/.test(t)&&!names.includes(t))throw 0;i=re.lastIndex}const x=Function(...names,'"use strict";return ('+expr+')')(...names.map(n=>vars[n]));if(!Number.isFinite(Number(x)))throw 0;return Number(x)}
function apply(r){const v=r.VALORE||{};if(v.kind!=="calc")return;const vars={};for(const b of(v.inputs||[])){const n=read(b);if(!Number.isFinite(n))return;vars[b]=n}try{let x=calc(v.expr,vars);if(v.round!=null)x=Number(x.toFixed(Math.max(0,Math.min(12,Number(v.round)||0))));write(v.output,(v.prefix||"")+x+(v.suffix||""),v.property)}catch(e){}}
function all(){REL.forEach(apply)}document.addEventListener("input",all);document.addEventListener("change",all);all();
<\/script></body></html>`;
}

