<script>
const BUILD="0.00000000.000000000.1 Alpha--torture-tested";
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));

const RIKI={
  BYTE:{name:"RIKI_SPACE_MONO",constitution:"RIKI_CORE_0.0.1_ALPHA__BYTE_PERMANENT__VALUE_DYNAMIC__BIT_DERIVED__CHAINS_PERMANENT"},
  VALORE:{
    currentView:"projects",
    currentProject:null,
    settings:{provider:"demo",openrouterModel:"openai/gpt-5.6-luna",openaiModel:"gpt-5.6-luna",appName:"RIKI Space",siteUrl:""},
    projects:{},
    audit:[]
  },
  BIT:0,
  CATENE:[]
};

/* Session-only secrets: never canonical, never exported, never persisted. */
const SESSION_SECRETS={openrouterKey:"",openaiKey:""};

/* Technical audit only. It is not a RIKI CHAIN and never determines BIT. */
function commit(op,project=null,detail=""){
  RIKI.VALORE.audit ||= [];
  RIKI.VALORE.audit.push({t:Date.now(),op,project,detail:String(detail||"")});
  if(RIKI.VALORE.audit.length>400) RIKI.VALORE.audit.shift();
}

function cloneJSON(x){return JSON.parse(JSON.stringify(x))}

const BYTE_RE=/^[A-Za-z_][A-Za-z0-9_]*$/;
function isSafeByteName(x){return typeof x==="string" && BYTE_RE.test(x)}
function safeCalc(expr,vars){
  expr=String(expr||"").trim();
  if(!expr) throw new Error("empty expression");
  const names=Object.keys(vars);
  const token=/[A-Za-z_][A-Za-z0-9_]*|(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+\-]?\d+)?|\*\*|[+\-*/%()]|\s+/gy;
  let i=0,m;
  while(i<expr.length){
    token.lastIndex=i; m=token.exec(expr);
    if(!m || m.index!==i) throw new Error("unsafe expression token");
    const t=m[0];
    if(/^[A-Za-z_]/.test(t) && !names.includes(t)) throw new Error("unknown expression symbol: "+t);
    i=token.lastIndex;
  }
  const out=Function(...names,'"use strict";return ('+expr+')')(...names.map(n=>vars[n]));
  const n=Number(out);
  if(!Number.isFinite(n)) throw new Error("expression result is not finite");
  return n;
}
function nearlyEqual(a,b){
  a=Number(a); b=Number(b);
  return Number.isFinite(a)&&Number.isFinite(b)&&Math.abs(a-b)<=1e-9*Math.max(1,Math.abs(a),Math.abs(b));
}

function normalizeApp(app){
  if(!app || typeof app!=="object") return app;
  app.VALORE ||= {};
  app.VALORE.canvas ||= {};
  app.VALORE.nodes ||= [];
  // compatibility only: migrate legacy imported relation arrays into permanent CATENE once
  if(Array.isArray(app.VALORE.relations) && app.VALORE.relations.length){
    app.CATENE ||= [];
    for(const r of app.VALORE.relations){
      if(!r?.BYTE || app.CATENE.some(c=>c?.BYTE===r.BYTE)) continue;
      app.CATENE.push({BYTE:r.BYTE,DOMAIN:r?.VALORE?.trigger||"app",VALORE:cloneJSON(r.VALORE||{})});
    }
  }
  delete app.VALORE.relations;
  app.CATENE ||= [];
  for(const n of app.VALORE.nodes){
    if(n && typeof n==="object") n.BIT=0; // derived below, never authored
  }
  app.BIT=0;
  return app;
}

function nodeMap(app){
  return new Map((app?.VALORE?.nodes||[]).map(n=>[n?.BYTE,n]).filter(x=>x[0]));
}

function numericNodeValue(n){
  const v=n?.VALORE||{};
  if(v.value!==undefined && v.value!==""){
    const x=Number(v.value); if(Number.isFinite(x)) return x;
  }
  if(v.text!==undefined){
    const x=Number(String(v.text).replace(/[^0-9eE+\-.]/g,""));
    if(Number.isFinite(x)) return x;
  }
  return NaN;
}

function evaluateChainExpected(app,c){
  const v=c?.VALORE||{}, map=nodeMap(app);
  if(v.kind!=="calc" || !Array.isArray(v.inputs) || !v.inputs.length || !v.output || typeof v.expr!=="string") return null;
  const out=map.get(v.output);
  if(!out || !v.inputs.every(b=>map.has(b))) return null;
  const vars={};
  for(const b of v.inputs){
    const x=numericNodeValue(map.get(b));
    if(!Number.isFinite(x)) return null;
    vars[b]=x;
  }
  try{
    let x=safeCalc(v.expr,vars);
    if(v.round!=null) x=Number(x.toFixed(Math.max(0,Math.min(12,Number(v.round)||0))));
    return {x,output:v.output,property:v.property,prefix:v.prefix||"",suffix:v.suffix||""};
  }catch{return null}
}

function applyUniversalOperator(app){
  normalizeApp(app);
  // Simultaneous fixed-point updates: every pass reads one state, then commits all outputs together.
  // BYTE identities and CATENE definitions are never changed.
  for(let pass=0;pass<64;pass++){
    const proposals=new Map(), conflicts=new Set();
    for(const c of app.CATENE||[]){
      const e=evaluateChainExpected(app,c);
      if(!e) continue;
      if(proposals.has(e.output) && !nearlyEqual(proposals.get(e.output).x,e.x)) conflicts.add(e.output);
      else if(!proposals.has(e.output)) proposals.set(e.output,e);
    }
    let changed=false;
    const map=nodeMap(app);
    for(const [outByte,e] of proposals){
      if(conflicts.has(outByte)) continue;
      const out=map.get(outByte); if(!out) continue;
      out.VALORE ||= {};
      const useValue=e.property==="value" || ("value" in out.VALORE && e.property!=="text");
      if(useValue){
        const prev=Number(out.VALORE.value);
        if(!nearlyEqual(prev,e.x)){out.VALORE.value=e.x;changed=true}
      }else{
        const next=e.prefix+e.x+e.suffix;
        if(String(out.VALORE.text??"")!==next){out.VALORE.text=next;changed=true}
      }
    }
    if(!changed) break;
  }
}

function chainTruth(app,c){
  if(!c?.DOMAIN || !String(c.DOMAIN).trim()) return false;
  const e=evaluateChainExpected(app,c);
  if(!e) return false;
  const actual=numericNodeValue(nodeMap(app).get(e.output));
  return nearlyEqual(e.x,actual);
}

function validateRikiApp(app,{derive=true}={}){
  const errors=[];
  normalizeApp(app);
  if(!app || typeof app!=="object") return {ok:false,errors:["rikiApp missing"]};
  if(!isSafeByteName(app.BYTE)) errors.push("rikiApp BYTE missing or unsafe");
  if(!app.VALORE || typeof app.VALORE!=="object") errors.push("VALORE missing");
  if(!Array.isArray(app.VALORE?.nodes)) errors.push("VALORE.nodes must be an array");
  if(!Array.isArray(app.CATENE)) errors.push("CATENE must be an array");

  const bytes=new Set();
  for(const [i,n] of (app.VALORE?.nodes||[]).entries()){
    if(!n || typeof n!=="object"){errors.push(`node ${i} invalid`);continue}
    if(!isSafeByteName(n.BYTE)) errors.push(`node ${i} BYTE missing or unsafe`);
    else{
      if(bytes.has(n.BYTE)) errors.push(`duplicate BYTE: ${n.BYTE}`);
      bytes.add(n.BYTE);
    }
    if(!n.VALORE || typeof n.VALORE!=="object") errors.push(`BYTE ${n.BYTE||i} VALORE missing`);
  }
  for(const n of (app.VALORE?.nodes||[])){
    for(const child of (n?.VALORE?.children||[])) if(!bytes.has(child)) errors.push(`child BYTE not found: ${child}`);
  }

  const chainBytes=new Set();
  for(const [i,c] of (app.CATENE||[]).entries()){
    if(!c || typeof c!=="object"){errors.push(`CHAIN ${i} invalid`);continue}
    if(!isSafeByteName(c.BYTE)) errors.push(`CHAIN ${i} BYTE missing or unsafe`);
    else{
      if(chainBytes.has(c.BYTE)) errors.push(`duplicate CHAIN BYTE: ${c.BYTE}`);
      chainBytes.add(c.BYTE);
    }
    if(typeof c.DOMAIN!=="string" || !c.DOMAIN.trim()) errors.push(`CHAIN ${c.BYTE||i} domain undefined`);
    if(!c.VALORE || typeof c.VALORE!=="object"){errors.push(`CHAIN ${c.BYTE||i} VALORE missing`);continue}
    const v=c.VALORE;
    if(v.kind!=="calc") errors.push(`CHAIN ${c.BYTE||i} kind must be calc equality`);
    if(v.kind==="calc"){
      if(!Array.isArray(v.inputs) || !v.inputs.length) errors.push(`CHAIN ${c.BYTE||i} inputs missing`);
      for(const b of (v.inputs||[])) if(!bytes.has(b)) errors.push(`CHAIN input BYTE not found: ${b}`);
      if(!v.output || !bytes.has(v.output)) errors.push(`CHAIN output BYTE not found: ${v.output||""}`);
      if(typeof v.expr!=="string" || !v.expr.trim()) errors.push(`CHAIN ${c.BYTE||i} expression missing`);
      else {
        const vars=Object.fromEntries((v.inputs||[]).filter(isSafeByteName).map(b=>[b,1]));
        try{safeCalc(v.expr,vars)}catch(e){errors.push(`CHAIN ${c.BYTE||i} expression unsafe/invalid: ${e.message}`)}
      }
    }
  }

  // hierarchy may change as a VALUE, but it cannot form a cycle
  const graph=new Map((app.VALORE?.nodes||[]).map(n=>[n.BYTE,n.VALORE?.children||[]]));
  const visiting=new Set(),visited=new Set();
  function dfs(b){
    if(visiting.has(b)){errors.push(`node cycle detected at: ${b}`);return}
    if(visited.has(b)) return;
    visiting.add(b); for(const c of graph.get(b)||[]) dfs(c); visiting.delete(b); visited.add(b);
  }
  for(const b of graph.keys()) dfs(b);

  if(derive){
    applyUniversalOperator(app);
    const chainValidity=new Map();
    for(const c of app.CATENE||[]){
      const ok=chainTruth(app,c);
      chainValidity.set(c.BYTE,ok);
      c.BIT=ok?1:0; // strictly derived from the equality after U has acted
    }
    for(const n of app.VALORE?.nodes||[]){
      const connected=(app.CATENE||[]).filter(c=>{
        const v=c.VALORE||{};return (v.inputs||[]).includes(n.BYTE)||v.output===n.BYTE;
      });
      // RIKI CORE: no connected CHAIN => BIT 0.
      n.BIT=connected.length>0 && connected.every(c=>chainValidity.get(c.BYTE)===true) ? 1 : 0;
    }
    // The app can be structurally valid while BIT=0; BIT means its declared chain network is closed.
    app.BIT=errors.length===0 && (app.CATENE||[]).length>0 && (app.CATENE||[]).every(c=>c.BIT===1) ? 1 : 0;
  }
  return {ok:errors.length===0,errors,bit:app.BIT};
}

function immutableSignature(app){
  normalizeApp(app);
  return {
    BYTE:app.BYTE,
    nodeBytes:(app.VALORE.nodes||[]).map(n=>n.BYTE),
    chains:(app.CATENE||[]).map(c=>({BYTE:c.BYTE,DOMAIN:c.DOMAIN,VALORE:c.VALORE}))
  };
}

function validatePermanentMutation(before,after){
  normalizeApp(before); normalizeApp(after);
  const errors=[];
  if(after.BYTE!==before.BYTE) errors.push("app BYTE is permanent and cannot change");
  const oldNodes=new Map((before.VALORE.nodes||[]).map(n=>[n.BYTE,n]));
  const newNodes=new Map((after.VALORE.nodes||[]).map(n=>[n.BYTE,n]));
  for(const b of oldNodes.keys()) if(!newNodes.has(b)) errors.push(`BYTE ${b} is permanent and cannot be deleted or renamed`);
  const oldChains=new Map((before.CATENE||[]).map(c=>[c.BYTE,c]));
  const newChains=new Map((after.CATENE||[]).map(c=>[c.BYTE,c]));
  for(const [b,c] of oldChains){
    if(!newChains.has(b)) errors.push(`CHAIN ${b} is permanent and cannot be deleted`);
    else if(JSON.stringify({DOMAIN:c.DOMAIN,VALORE:c.VALORE})!==JSON.stringify({DOMAIN:newChains.get(b).DOMAIN,VALORE:newChains.get(b).VALORE}))
      errors.push(`CHAIN ${b} is permanent and cannot be modified`);
  }
  return {ok:errors.length===0,errors};
}

function applyRikiTransform(app,ops){
  const next=cloneJSON(app); normalizeApp(next);
  const nodes=next.VALORE.nodes, chains=next.CATENE;
  const nodeIndex=b=>nodes.findIndex(n=>n?.BYTE===b);
  const chainIndex=b=>chains.findIndex(c=>c?.BYTE===b);

  for(const op of ops||[]){
    if(!op || typeof op!=="object" || typeof op.op!=="string") throw new Error("invalid RIKI operation");
    if(op.op==="setTitle") next.VALORE.title=String(op.value??"");
    else if(op.op==="setCanvas") next.VALORE.canvas={...next.VALORE.canvas,...cloneJSON(op.value||{})};
    else if(op.op==="declareByte"){
      const n=cloneJSON(op.node);
      if(!isSafeByteName(n?.BYTE)) throw new Error("declareByte requires a safe BYTE name");
      if(nodeIndex(n.BYTE)>=0) throw new Error("BYTE already exists permanently: "+n.BYTE);
      n.VALORE ||= {}; n.BIT=0; nodes.push(n);
    }
    else if(op.op==="setValue"){
      const i=nodeIndex(op.BYTE);
      if(i<0) throw new Error("BYTE not found: "+op.BYTE);
      nodes[i].VALORE={...(nodes[i].VALORE||{}),...cloneJSON(op.value||{})};
    }
    else if(op.op==="declareChain"){
      const c=cloneJSON(op.chain);
      if(!isSafeByteName(c?.BYTE)) throw new Error("declareChain requires a safe BYTE name");
      if(chainIndex(c.BYTE)>=0) throw new Error("CHAIN already exists permanently: "+c.BYTE);
      c.DOMAIN=String(c.DOMAIN||c?.VALORE?.trigger||"app"); c.BIT=0; c.VALORE ||= {}; chains.push(c);
    }
    else throw new Error("unsupported by RIKI CORE 0.0.1 Alpha: "+op.op);
  }
  const permanence=validatePermanentMutation(app,next);
  if(!permanence.ok) throw new Error(permanence.errors.join(" · "));
  const check=validateRikiApp(next,{derive:true});
  if(!check.ok) throw new Error(check.errors.join(" · "));
  return next;
}

function validateSpace(space){
  const errors=[];
  if(!space || typeof space!=="object") return {ok:false,errors:["Space missing"]};
  if(!space.BYTE?.name) errors.push("Space BYTE.name missing");
  if(!space.VALORE?.projects || typeof space.VALORE.projects!=="object") errors.push("projects missing");
  for(const [id,p] of Object.entries(space.VALORE?.projects||{})){
    if(!p?.BYTE?.name) errors.push(`project ${id} BYTE missing`);
    const check=validateRikiApp(p.VALORE?.rikiApp,{derive:true});
    p.BIT=check.ok && p.VALORE.rikiApp.BIT===1 ? 1 : 0;
    if(!check.ok) errors.push(...check.errors.map(e=>`${id}: ${e}`));
  }
  space.BIT=errors.length===0 && Object.values(space.VALORE?.projects||{}).every(p=>p.BIT===1||p.VALORE?.archived) ? 1 : 0;
  return {ok:errors.length===0,errors,bit:space.BIT};
}

function exportSpaceObject(){
  const check=validateSpace(RIKI);
  if(!check.ok) throw new Error(check.errors.join("\n"));
  commit("space_backup_export");
  const copy=structuredClone(RIKI);
  // Never place an API secret in a backup file.
  if(copy.VALORE?.settings){ delete copy.VALORE.settings.openrouterKey; delete copy.VALORE.settings.openaiKey; }
  return copy;
}

function importSpaceObject(obj){
  const copy=structuredClone(obj);
  copy.VALORE ||= {}; copy.VALORE.audit ||= [];
  for(const p of Object.values(copy.VALORE.projects||{})) normalizeApp(p.VALORE?.rikiApp);
  const check=validateSpace(copy);
  if(!check.ok) throw new Error(check.errors.join("\n"));
  RIKI.BYTE=copy.BYTE; RIKI.VALORE=copy.VALORE; RIKI.BIT=copy.BIT; RIKI.CATENE=copy.CATENE||[];
  commit("space_import"); renderPublic(); if(!$("#admin").classList.contains("hidden")) renderAdmin();
}

