    body=`<div class="view"><div class="chat"><div class="messages">${p.VALORE.messages.map(m=>`<div class="msg ${m.role==="user"?"user":""}">${esc(m.content)}</div>`).join("")||"<div class='msg'>Ask RIKI to modify this project.</div>"}</div>
    <div class="composer"><textarea id="prompt" placeholder="Message RIKI..."></textarea><div class="row"><span class="status" id="status">ready</span><button class="btn primary" id="send">send</button></div></div></div></div>`;
  }else if(tab==="preview"){
    body=`<div class="view preview"><div class="previewbar"><span>preview</span></div><iframe id="preview"></iframe></div>`;
  }else if(tab==="code"){
    const mode=p.VALORE.ui.codeMode;
    const src=mode==="html"?appToHTML(p.VALORE):JSON.stringify(p.VALORE.rikiApp,null,2);
    body=`<div class="view code"><div class="codebar"><div><button class="btn ${mode==="riki"?"primary":""}" data-mode="riki">riki</button> <button class="btn ${mode==="html"?"primary":""}" data-mode="html">html</button></div>${mode==="riki"?'<button class="btn primary" id="saveCode">save</button>':'<span class="status">read only</span>'}</div><textarea id="editor" ${mode==="html"?"readonly":""}>${esc(src)}</textarea></div>`;
  }else if(tab==="history"){
    ensureHistory(p);
    const history=p.VALORE.history||[];
    body=`<div class="view" style="padding:18px;overflow:auto;max-width:900px;margin:auto;width:100%">
      <div class="status" style="margin-bottom:12px">Audit only — history is not a CATENA and does not create a parallel canonical state.</div>
      ${history.length?history.slice().reverse().map(x=>`<div style="border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:10px">
        <div><strong>${esc(x.source||"change")}</strong><div class="status">${new Date(x.t).toLocaleString()} · changed BYTE: ${esc((x.changed||[]).join(", ")||"none")}</div></div>
      </div>`).join(""):`<div class="status">no value changes yet</div>`}
    </div>`;
  }else{
    body=`<div class="view" style="padding:18px"><button class="btn primary" id="export">export html</button></div>`;
  }
  const projectTabs=["chat","preview","code","history","publish"];
  $("#content").innerHTML=`<section class="project"><div class="tabs">${projectTabs.map(t=>`<button data-tab="${t}" class="${t===tab?"active":""}">${t}</button>`).join("")}</div>${body}</section>`;
  document.querySelectorAll("[data-tab]").forEach(x=>x.onclick=()=>{p.VALORE.ui.tab=x.dataset.tab;syncSideMenu();renderProject(id)});
  $("#archive").onclick=()=>{p.VALORE.archived=!p.VALORE.archived;commit(p.VALORE.archived?"project_archive":"project_unarchive",id);RIKI.VALORE.currentProject=null;renderAdmin();renderPublic()};
  if(tab==="preview")$("#preview").srcdoc=appToHTML(p.VALORE);
  if(tab==="code"){
    document.querySelectorAll("[data-mode]").forEach(x=>x.onclick=()=>{p.VALORE.ui.codeMode=x.dataset.mode;renderProject(id)});
    if(p.VALORE.ui.codeMode==="riki")$("#saveCode").onclick=()=>{
      try{
        const x=JSON.parse($("#editor").value); normalizeApp(x);
        const perm=validatePermanentMutation(p.VALORE.rikiApp,x);
        if(!perm.ok) throw Error(perm.errors.join("\n"));
        const check=validateRikiApp(x,{derive:true});
        if(!check.ok) throw Error(check.errors.join("\n"));
        recordHistory(p,x,"code"); commit("code_save_validated",id);
        renderProject(id);renderPublic()
      }catch(e){alert("RIKI validation error:\n"+e.message)}
    };
  }
  if(tab==="publish")$("#export").onclick=()=>{const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([appToHTML(p.VALORE)],{type:"text/html"}));a.download=p.BYTE.name.replace(/\W+/g,"-")+".html";a.click()};
  if(tab==="chat"){
    $("#send").onclick=()=>sendPrompt(id);
    $("#prompt").addEventListener("keydown",e=>{
      if((e.ctrlKey||e.metaKey) && e.key==="Enter"){
        e.preventDefault();
        sendPrompt(id);
      }
    });
  }
}
function rikiSystemPrompt(current){
  return `You are the RIKI application composer for RIKI CORE 0.0.1 Alpha.

Canonical rules are mandatory:
- BYTE is one unique permanent canonical identity. Once declared it can never be deleted, renamed, replaced or duplicated.
- VALORE is the permanent dynamic value of the same BYTE. Change the VALORE; never recreate the BYTE.
- CATENE are permanent mathematical equalities with a defined non-empty domain. Once declared they can never be edited or deleted.
- BIT is DERIVED by the runtime from the connected CATENE. You must never author, set, force or patch BIT.
- Never create snapshots, parallel canonical states or hidden duplicate state.

You MUST NOT output HTML or JavaScript and MUST NOT return the whole application.
Return ONLY one strict compact JSON object:
{"reply":"short response","ops":[...]}

Allowed operations only:
1. {"op":"setTitle","value":"Title"}
2. {"op":"setCanvas","value":{"background":"#fff","color":"#111","maxWidth":1200,"padding":24,"gap":16}}
3. {"op":"declareByte","node":{"BYTE":"unique_name","VALORE":{"tag":"div","text":"text","value":"optional","attrs":{},"style":{},"children":[]}}}
4. {"op":"setValue","BYTE":"existing_BYTE","value":{"text":"new text","style":{"fontSize":"42px"},"children":["BYTE"]}}
5. {"op":"declareChain","chain":{"BYTE":"chain_name","DOMAIN":"input","VALORE":{"kind":"calc","inputs":["a","b"],"output":"result","expr":"a+b","property":"text","prefix":"","suffix":"","round":2}}}

Forbidden: delete, replace, rename, setAppBYTE, updateChain, deleteChain, manual BIT, snapshots, recreation of an existing BYTE.
For a new project, declare enough BYTEs to build a useful interface. Preserve every existing BYTE and CHAIN forever. Parent/child hierarchy is a dynamic VALORE and may change with setValue. Use only calc equality chains for canonical behavior. Strict JSON only, no markdown fences.

Current canonical RIKI app:
${JSON.stringify(current)}`;
}

function parseTransformRaw(raw){
  raw=String(raw||"").trim();
  if(!raw) throw new Error("empty response from model");
  raw=raw.replace(/^```(?:json)?\s*/i,"").replace(/\s*```$/,"").trim();
  try{return JSON.parse(raw)}catch{}
  const a=raw.indexOf("{"), b=raw.lastIndexOf("}");
  if(a<0||b<=a) throw new Error("model did not return RIKI transform JSON");
  try{return JSON.parse(raw.slice(a,b+1))}catch(e){throw new Error("invalid transform JSON: "+e.message)}
}

function demoTransform(current,text){
  const q=String(text||"").trim();
  const low=q.toLowerCase();
  const existing=new Set((current.nodes||[]).map(n=>n.BYTE));
  const ops=[];
  const safeBase=x=>String(x||"NODE").toUpperCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^A-Z0-9_]+/g,"_").replace(/^([^A-Z_])/,"_$1").replace(/^_+|_+$/g,"").slice(0,40)||"NODE";
  const unique=base=>{let n=safeBase(base),i=2;while(existing.has(n)){n=safeBase(base)+"_"+(i++)}existing.add(n);return n};

  if(/titolo|title/.test(low)){
    const m=q.match(/(?:titolo|title)(?:\s+(?:in|to|a))?\s*["“]?([^"”\n]+)["”]?/i);
    ops.push({op:"setTitle",value:(m?.[1]||q.replace(/.*(?:titolo|title)/i,"").trim()||"RIKI App").slice(0,120)});
  }
  if(/sfondo|background/.test(low)){
    const color=(q.match(/#[0-9a-f]{3,8}\b/i)||q.match(/\b(?:white|black|gray|grey|red|green|blue|yellow|orange|purple|pink)\b/i)||[])[0]||"#f6f6f6";
    ops.push({op:"setCanvas",value:{...(current.canvas||{}),background:color}});
  }
  if(/landing|pagina|page|sito|site|hero|pulsante|button|testo|text|crea|create|aggiungi|add/.test(low)){
    const root=(current.nodes||[]).find(n=>Array.isArray(n?.VALORE?.children)&&n.BYTE==="ROOT") || (current.nodes||[]).find(n=>Array.isArray(n?.VALORE?.children));
    if(!root){
      const rid=unique("ROOT");
      ops.push({op:"declareByte",node:{BYTE:rid,VALORE:{tag:"main",text:"",attrs:{},style:{maxWidth:"960px",margin:"0 auto",padding:"48px 24px"},children:[]}}});
    }
    const heading=unique("DEMO_HEADING");
    const para=unique("DEMO_TEXT");
    const button=unique("DEMO_BUTTON");
    ops.push({op:"declareByte",node:{BYTE:heading,VALORE:{tag:"h1",text:"RIKI demo is working",attrs:{},style:{fontSize:"48px",margin:"0 0 16px"},children:[]}}});
    ops.push({op:"declareByte",node:{BYTE:para,VALORE:{tag:"p",text:q||"Local deterministic DEMO transform.",attrs:{},style:{fontSize:"18px",lineHeight:"1.5"},children:[]}}});
    ops.push({op:"declareByte",node:{BYTE:button,VALORE:{tag:"button",text:"RIKI",attrs:{type:"button"},style:{padding:"10px 16px",border:"1px solid #111",background:"#fff",color:"#111"},children:[]}}});
    const target=root?.BYTE||"ROOT";
    if(existing.has(target) || (current.nodes||[]).some(n=>n.BYTE===target)){
      const old=(current.nodes||[]).find(n=>n.BYTE===target)?.VALORE||{};
      ops.push({op:"setValue",BYTE:target,value:{...old,children:[...(old.children||[]),heading,para,button]}});
    }
  }
  if(!ops.length){
    const node=(current.nodes||[]).find(n=>n.BYTE && n.BYTE!=="ROOT");
    if(node) ops.push({op:"setValue",BYTE:node.BYTE,value:{...node.VALORE,text:q}});
    else{
      const id=unique("DEMO_TEXT");
      ops.push({op:"declareByte",node:{BYTE:id,VALORE:{tag:"p",text:q,attrs:{},style:{},children:[]}}});
    }
  }
  return {reply:"DEMO applied locally — no API call and no cost.",ops};
}

async function callOpenRouter(system,text,s){
  if(!SESSION_SECRETS.openrouterKey) throw new Error("set OpenRouter API key in settings");
  if(!s.openrouterModel) throw new Error("set an OpenRouter model in settings");
  const headers={"Authorization":"Bearer "+SESSION_SECRETS.openrouterKey,"Content-Type":"application/json"};
  if(s.siteUrl) headers["HTTP-Referer"]=s.siteUrl;
  if(s.appName) headers["X-Title"]=s.appName;
  const r=await fetch("https://openrouter.ai/api/v1/chat/completions",{method:"POST",headers,body:JSON.stringify({model:s.openrouterModel,messages:[{role:"system",content:system},{role:"user",content:text}],temperature:0.08,max_tokens:12000})});
  const responseText=await r.text();
  let envelope; try{envelope=JSON.parse(responseText)}catch{throw new Error("OpenRouter returned an unreadable response")}
  if(!r.ok) throw new Error(envelope?.error?.message||`OpenRouter HTTP ${r.status}`);
  let raw=envelope?.choices?.[0]?.message?.content;
  if(Array.isArray(raw)) raw=raw.map(x=>x?.text||x?.content||"").join("");
  return parseTransformRaw(raw);
}

async function callOpenAI(system,text,s){
  if(!SESSION_SECRETS.openaiKey) throw new Error("set OpenAI API key in settings");
  if(!s.openaiModel) throw new Error("set an OpenAI model in settings");
  const r=await fetch("https://api.openai.com/v1/responses",{
    method:"POST",
    headers:{"Authorization":"Bearer "+SESSION_SECRETS.openaiKey,"Content-Type":"application/json"},
    body:JSON.stringify({
      model:s.openaiModel,
      input:[
        {role:"system",content:[{type:"input_text",text:system}]},
        {role:"user",content:[{type:"input_text",text:text}]}
      ],
      text:{format:{type:"json_object"}},
      max_output_tokens:12000
    })
  });
  const responseText=await r.text();
  let envelope; try{envelope=JSON.parse(responseText)}catch{throw new Error("OpenAI returned an unreadable response")}
  if(!r.ok) throw new Error(envelope?.error?.message||`OpenAI HTTP ${r.status}`);
  const raw=(envelope.output||[]).flatMap(o=>o?.content||[]).filter(c=>c?.type==="output_text").map(c=>c.text||"").join("").trim();
  return parseTransformRaw(raw);
}

async function sendPrompt(id){
  const p=project(id);
  const input=$("#prompt");
  const text=input?.value.trim();
  if(!text)return;
  const s=RIKI.VALORE.settings;
  const provider=s.provider||"demo";
  const status=$("#status");
  const send=$("#send");

  p.VALORE.messages.push({role:"user",content:text});
  input.value="";
  status.textContent=provider==="demo"?"testing locally…":"thinking…";
  send.disabled=true;
  const current=p.VALORE.rikiApp;
  const system=rikiSystemPrompt(current);

  try{
    let out;
    if(provider==="demo") out=demoTransform(current,text);
    else if(provider==="openai") out=await callOpenAI(system,text,s);
    else if(provider==="openrouter") out=await callOpenRouter(system,text,s);
    else throw new Error("unknown provider: "+provider);

    if(!Array.isArray(out.ops)) throw new Error("RIKI transform has no ops array");
    if(out.ops.length===0) throw new Error("model returned no RIKI operations");
    const candidate=applyRikiTransform(current,out.ops);
    const check=validateRikiApp(candidate);
    if(!check.ok) throw new Error("RIKI validation failed: "+check.errors.join(" · "));
    recordHistory(p,candidate,provider);
    p.VALORE.messages.push({role:"ai",content:out.reply||"updated"});
    renderProject(id); renderPublic();
  }catch(e){
    p.VALORE.messages.push({role:"ai",content:"Error: "+e.message});
    renderProject(id);
  }finally{
    const b=$("#send"); if(b)b.disabled=false;
    const st=$("#status"); if(st)st.textContent="ready";
  }
}


function runTortureTests(){
  const results=[];
  const t=(name,fn)=>{try{const v=fn();results.push({name,ok:v!==false,detail:v===false?"returned false":""})}catch(e){results.push({name,ok:false,detail:e.message})}};
  t("safeCalc arithmetic",()=>safeCalc("a*b+2",{a:3,b:4})===14);
  t("safeCalc blocks global access",()=>{try{safeCalc("window.alert(1)",{window:1});return false}catch{return true}});
  t("duplicate BYTE rejected",()=>{const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{}},{BYTE:"A",VALORE:{}}],canvas:{}},CATENE:[],BIT:0};return !validateRikiApp(a).ok});
  t("permanent BYTE deletion rejected",()=>{const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{text:"1"}}],canvas:{}},CATENE:[],BIT:0};const b=cloneJSON(a);b.VALORE.nodes=[];return !validatePermanentMutation(a,b).ok});
  t("permanent CHAIN edit rejected",()=>{const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{value:1}},{BYTE:"B",VALORE:{value:0}}],canvas:{}},CATENE:[{BYTE:"C",DOMAIN:"d",VALORE:{kind:"calc",inputs:["A"],output:"B",expr:"A"}}],BIT:0};const b=cloneJSON(a);b.CATENE[0].VALORE.expr="A+1";return !validatePermanentMutation(a,b).ok});
  t("BIT derived to 1",()=>{const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{value:2}},{BYTE:"B",VALORE:{value:3}},{BYTE:"C",VALORE:{value:0}}],canvas:{}},CATENE:[{BYTE:"SUM",DOMAIN:"d",VALORE:{kind:"calc",inputs:["A","B"],output:"C",expr:"A+B",property:"value"}}],BIT:0};validateRikiApp(a);return a.BIT===1&&numericNodeValue(nodeMap(a).get("C"))===5});
  t("simultaneous chain order independence",()=>{const mk=order=>{const cs=[{BYTE:"C1",DOMAIN:"d",VALORE:{kind:"calc",inputs:["A"],output:"B",expr:"A+1",property:"value"}},{BYTE:"C2",DOMAIN:"d",VALORE:{kind:"calc",inputs:["B"],output:"C",expr:"B+1",property:"value"}}];const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{value:1}},{BYTE:"B",VALORE:{value:0}},{BYTE:"C",VALORE:{value:0}}],canvas:{}},CATENE:order?cs:cs.reverse(),BIT:0};validateRikiApp(a);return [numericNodeValue(nodeMap(a).get("B")),numericNodeValue(nodeMap(a).get("C")),a.BIT]};return JSON.stringify(mk(true))===JSON.stringify(mk(false))&&mk(true)[1]===3});
  t("conflicting chains keep BIT 0",()=>{const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{value:1}},{BYTE:"B",VALORE:{value:0}}],canvas:{}},CATENE:[{BYTE:"C1",DOMAIN:"d",VALORE:{kind:"calc",inputs:["A"],output:"B",expr:"A+1",property:"value"}},{BYTE:"C2",DOMAIN:"d",VALORE:{kind:"calc",inputs:["A"],output:"B",expr:"A+2",property:"value"}}],BIT:0};validateRikiApp(a);return a.BIT===0});
  t("unsupported delete op blocked",()=>{const a={BYTE:"APP",VALORE:{nodes:[{BYTE:"A",VALORE:{text:"x"}}],canvas:{}},CATENE:[],BIT:0};try{applyRikiTransform(a,[{op:"deleteByte",BYTE:"A"}]);return false}catch{return true}});
  t("generated HTML blocks script tag",()=>{const p={rikiApp:{BYTE:"APP",VALORE:{title:"x",canvas:{},nodes:[{BYTE:"X",VALORE:{tag:"script",text:"alert(1)",attrs:{}}}]},CATENE:[],BIT:0}};const h=appToHTML(p);return !/<script data-riki-byte="X"/i.test(h)&&/<div data-riki-byte="X"/i.test(h)});
  t("generated HTML blocks event attrs",()=>{const p={rikiApp:{BYTE:"APP",VALORE:{title:"x",canvas:{},nodes:[{BYTE:"X",VALORE:{tag:"button",text:"x",attrs:{onclick:"alert(1)",type:"button"}}}]},CATENE:[],BIT:0}};const h=appToHTML(p);return !/onclick=/i.test(h)&&/type="button"/i.test(h)});
  t("generated HTML blocks javascript href",()=>{const p={rikiApp:{BYTE:"APP",VALORE:{title:"x",canvas:{},nodes:[{BYTE:"X",VALORE:{tag:"a",text:"x",attrs:{href:"javascript:alert(1)"}}}]},CATENE:[],BIT:0}};const h=appToHTML(p);return !/javascript:/i.test(h)&&/href="#"/i.test(h)});
  t("generated HTML blocks CSS url",()=>{const p={rikiApp:{BYTE:"APP",VALORE:{title:"x",canvas:{},nodes:[{BYTE:"X",VALORE:{tag:"div",text:"x",style:{background:"url(https://evil.test/x)"}}}]},CATENE:[],BIT:0}};const h=appToHTML(p);return !/evil\.test/i.test(h)});
  t("DEMO emits valid transform",()=>{const p=Object.values(RIKI.VALORE.projects)[0];const o=demoTransform(p.VALORE.rikiApp.VALORE,"aggiungi testo di prova");const n=applyRikiTransform(p.VALORE.rikiApp,o.ops);return validateRikiApp(n).ok});
  t("backup excludes API keys",()=>{SESSION_SECRETS.openaiKey="SECRET_TEST";SESSION_SECRETS.openrouterKey="SECRET_ROUTER";const x=JSON.stringify(exportSpaceObject());SESSION_SECRETS.openaiKey="";SESSION_SECRETS.openrouterKey="";return !x.includes("SECRET_TEST")&&!x.includes("SECRET_ROUTER")});
  const ok=results.every(r=>r.ok);
  return {ok,passed:results.filter(r=>r.ok).length,total:results.length,results};
}

