  const b=new Map((after?.VALORE?.nodes||[]).map(n=>[n.BYTE,n.VALORE]));
  const out=[];
  for(const [k,v] of b) if(!a.has(k) || JSON.stringify(a.get(k))!==JSON.stringify(v)) out.push(k);
  return out;
}
function recordHistory(p,next,source){
  normalizeApp(p.VALORE.rikiApp); normalizeApp(next);
  const permanence=validatePermanentMutation(p.VALORE.rikiApp,next);
  if(!permanence.ok) throw new Error(permanence.errors.join(" · "));
  const changed=changedBytes(p.VALORE.rikiApp,next);
  p.VALORE.rikiApp=cloneJSON(next);
  validateRikiApp(p.VALORE.rikiApp,{derive:true});
  p.BIT=p.VALORE.rikiApp.BIT;
